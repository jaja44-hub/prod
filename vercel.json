{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/keepAlive",
      "schedule": "0 12 * * *"
    }
  ],
  "routes": [
    { "src": "/api/purchase/orders", "dest": "/api/purchase-orders.js" },
    { "src": "/api/purchase/suppliers", "dest": "/api/purchase-suppliers.js" },
    { "src": "/api/finance/journal", "dest": "/api/finance-journal.js" },
    { "src": "/api/inventory/products", "dest": "/api/inventory-products.js" },
    { "src": "/api/inventory/locations", "dest": "/api/inventory-locations.js" },
    { "src": "/api/inventory/warehouse", "dest": "/api/inventory-warehouse.js" },
    { "src": "/api/crm/activity", "dest": "/api/crm-activity.js" },
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
