# Prevent mono resources secrets from being uploaded
/../mono resources/
/service-account.json
/resources.md

# Exclude directories from Vercel deployment (local development only)
/server
/odoo-backend
/node_modules
/tests
/collected

# Exclude root-level test and seed files from Vercel deployment
*.mjs
seed.js
test_*.js
test_*.mjs
verify-*.mjs
extract-*.mjs
comprehensive-*.mjs
setup-*.mjs

# Keep scripts directory for build-time execution
# /scripts (commented out - needed for vercel-build)
