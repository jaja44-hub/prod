# Production sector Firebase (sample-firebase-ai-app-27a8e) — set on Vercel Production
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Default tenant for all production Firestore queries
VITE_TENANT_ID=production

# Optional legacy single-JSON config (used if VITE_FIREBASE_* are unset)
# VITE_FIREBASE_CONFIG={"apiKey":"...","projectId":"..."}

# Server-side only — Vercel secret for seed scripts / CI (not bundled)
# FIREBASE_SERVICE_ACCOUNT=

# ── Engineering Sector Cross-Sector Bridge ────────────────────────────────────
# The production sector reads live data (employees, projects, invoices, etc.)
# from the engineering sector's Firestore (project: ethiobusiness-hub).
# Public client config — safe to expose. No service account used in browser.
# NOTE: Defaults are pre-filled in EngineeringGateway.js so these are optional.
VITE_ENG_FIREBASE_API_KEY=AIzaSyAYmZ_OMI4A1OrxGpu-l0MzsdZkM8Vne5U
VITE_ENG_FIREBASE_AUTH_DOMAIN=ethiobusiness-hub.firebaseapp.com
VITE_ENG_FIREBASE_PROJECT_ID=ethiobusiness-hub
VITE_ENG_FIREBASE_STORAGE_BUCKET=ethiobusiness-hub.firebasestorage.app
VITE_ENG_FIREBASE_MESSAGING_SENDER_ID=675337488176
VITE_ENG_FIREBASE_APP_ID=1:675337488176:web:9d592fe13c5265bc1b2af5

# ── Neon DB Configuration (Server-side) ───────────────────────────────────────
# PostgreSQL connection string for Neon DB analytics layer
# Must be configured as Vercel environment variable for production
NEON_DATABASE_URL=postgresql://neondb_owner:password@ep-xyz.aws.neon.tech/neondb?sslmode=require

# ── Odoo Configuration (Server-side) ───────────────────────────────────────────
# Odoo instance configuration for data sync
ODOO_URL=https://your-odoo-instance.com
ODOO_DB=neondb
ODOO_USER=admin
ODOO_PASSWORD=admin

