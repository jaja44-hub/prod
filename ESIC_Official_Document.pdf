<style id="wp-custom-css">

# 14. Responsive / Media Queries
--------------------------------------------------------------*/
/* Use a mobile-first approach: style for small screens first, then add larger screen styles. */

/* Small devices (phones, 600px and up) */
@media (min-width: 600px) {
    .site-main {
        flex-direction: column; /* Stack main content and sidebar */
        gap: 0; 
			
			/* Remove gap */
    }

    .content-area,
    .widget-area {
        flex: none; /* Remove flex sizing */
        width: 100%; /* Take full width */
    }

    .site-branding {
        text-align: left; /* Align logo left on larger screens */
    }

    .main-navigation ul {
        justify-content: flex-end; /* Align menu right */
    }

    .menu-toggle {
        display: none; /* Hide toggle on larger screens */
    }
}

/* Medium devices (tablets, 768px and up) */
@media (min-width: 768px) {
    .container {
        padding: 0 30px;
    }

    .site-main {
        flex-direction: row; /* Revert to row for main content and sidebar */
        gap: 30px; /* Restore gap */
    }

    .content-area {
        flex: 3;
    }

    .widget-area {
        flex: 1;
    }

    h1 { font-size: 3em; }
    h2 { font-size: 2.5em; }

    .site-branding {
        float: left; /* Float logo left */
    }

    .main-navigation {
        float: right; /* Float navigation right */
        margin-top: 0;
    }
    .main-navigation ul {
        justify-content: flex-start; /* Or remove to let float handle it */
    }

    .site-header:after { /* Clearfix for floated elements in header */
        content: "";
        display: table;
        clear: both;
    }
}

/* Large devices (desktops, 1024px and up) */
@media (min-width: 1024px) {
    .container {
        padding: 0 40px;
    }

    h1 { font-size: 3.5em; }
    h2 { font-size: 2.8em; }

    /* Further refine layout for larger screens if needed */
}

/* Extra large devices (large desktops, 1200px and up) */
@media (min-width: 1200px) {
    .container {
        max-width: 1200px; /* Your desired max width */
        padding: 0; /* Remove padding if container handles it */
    }
}



/*new code */ 


/* Ensure proper box sizing */
*,
*::before,
*::after {
  box-sizing: border-box;
}



/* Body defaults */
body {
  margin: 0;
  font-family: Arial, sans-serif;
  line-height: 1.6;
}
.container {
  width: 90%;
  max-width: 1200px;
  margin: 0 auto;
}
.row {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
}

.col {
  flex: 1 1 100%;
}

/* Tablet */
@media (min-width: 768px) {
  .col-2 {
    flex: 1 1 calc(50% - 20px);
  }
}

/* Desktop */
@media (min-width: 1024px) {
  .col-3 {
    flex: 1 1 calc(33.333% - 20px);
  }
}
.nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
}

.nav-menu {
  display: none;
  flex-direction: column;
  width: 100%;
}

.nav-menu a {
  padding: 10px;
  text-decoration: none;
}


/* Show menu on larger screens */
@media (min-width: 768px) {
  .nav-menu {
    display: flex;
    flex-direction: row;
    width: auto;
  }
}
h1 {
  font-size: 1.8rem;
}

@media (min-width: 768px) {
  h1 {
    font-size: 2.2rem;
  }
}

@media (min-width: 1024px) {
  h1 {
    font-size: 2.8rem;
  }
}
.section {
  padding: 20px 10px;
}

@media (min-width: 768px) {
  .section {
    padding: 40px 20px;
  }
}

/* Prevent overflow from long content */
body {
  overflow-x: hidden;
}

/* Gutenberg blocks full width fix */
.wp-block {
  max-width: 100%;
}

/* Tables responsive */
table {
  width: 100%;
  display: block;
  overflow-x: auto;
}

.home .entry-title {
    display: none;
}


.elementor-6675 .elementor-element.elementor-element-68fc499 .elementor-posts-container .elementor-post__thumbnail img {
    display: block;
    margin-bottom: 0 !important;
}

/* Quick shortcut inside the widget's Custom CSS box */
selector .elementor-post__thumbnail img {
    display: block;
    margin-bottom: 0 !important;
}








</style>
</head>

